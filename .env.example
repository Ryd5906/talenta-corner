# Variables d'environnement — copier en .env.local et renseigner.

# Projet Sanity (https://sanity.io/manage) — facultatif :
# sans ces valeurs, le site affiche le contenu local de src/content/fallback.js.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01

# Studio Sanity (dossier sanity/)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
